[MESSAGES CONTROL]
# Docstrings aren't required in this project, and Pydantic models
# naturally have no public methods.
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,

[TYPECHECK]
# alembic.context and alembic.op are populated at runtime, so pylint can't see
# their functions.
ignored-modules=alembic.context,alembic.op

[FORMAT]
# The same limit as Black, which runs with its defaults (88 characters), so the two
# tools agree. There's deliberately no pyproject.toml: Vercel would install
# dependencies from it instead of requirements.txt.
max-line-length=88
