# Optional: FPL's API base URL. Only set it to point at a local mock.
# FPL_BASE_URL=https://fantasy.premierleague.com/api
# Optional: seconds before FPL calls time out, for the sync job and for the
# manager endpoints (someone in the app is waiting on those).
FPL_REQUEST_TIMEOUT=10
FPL_PROXY_TIMEOUT=5
# Supabase session pooler URI (Connect > Session pooler, port 5432), with the scheme
# changed to postgresql+psycopg:// and ?sslmode=require added. Use it locally and in
# the GitHub DATABASE_URL secret. Vercel uses the transaction pooler (port 6543)
# instead; see "Deployment (Vercel)" in the README.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_CONNECT_TIMEOUT=5
# Optional: connections per process (pool) and extra ones under load (overflow).
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
# Optional: the Supabase project whose sign-in tokens /api/me accepts. Without it,
# account routes return 503. Use staging's to test sign-in locally.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Optional: the same project's secret key (Project Settings > API Keys > Secret keys),
# for DELETE /api/me. Without it, account deletion returns 503. Never commit it.
# SUPABASE_SECRET_KEY=sb_secret_...
# Local test database (see "Tests and linting" in the README). Never Supabase.
TEST_DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5433/fpl_test
