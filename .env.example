FPL_BASE_URL=https://fantasy.premierleague.com/api
FPL_BOOTSTRAP_STATIC_PATH=/bootstrap-static/
FPL_REQUEST_TIMEOUT=10
# Supabase session pooler URI (Connect > Session pooler), with the scheme changed
# to postgresql+psycopg:// and ?sslmode=require added.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_CONNECT_TIMEOUT=5
