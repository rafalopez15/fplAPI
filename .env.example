# Optional: FPL's API base URL. Only set it to point at a local mock.
# FPL_BASE_URL=https://fantasy.premierleague.com/api
# Optional: seconds before FPL calls time out, for the sync job and for the
# manager endpoints (someone in the app is waiting on those).
FPL_REQUEST_TIMEOUT=10
FPL_PROXY_TIMEOUT=5
# Supabase session pooler URI (Connect > Session pooler), with the scheme changed
# to postgresql+psycopg:// and ?sslmode=require added.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_CONNECT_TIMEOUT=5
# Optional: connections per process (pool) and extra ones under load (overflow).
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
# Local test database (see "Tests and linting" in the README). Never Supabase.
TEST_DATABASE_URL=postgresql+psycopg://fpl:fpl@localhost:5433/fpl_test
